# =========================
# Laravel / PHP
# =========================
/vendor/
.env
.env.*
.phpunit.result.cache
.phpunit.cache
/storage/*.key
/storage/*.log

# Storage (NO versionar archivos ni links)
storage/app/*
!storage/app/.gitignore
!storage/app/public/
!storage/app/public/.gitignore

# =========================
# Public storage (symlink)
# =========================
public/storage

# =========================
# Node / Frontend
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / Build
# NOTA: public/build SÍ se versiona — el deploy a prod es `git pull`, así que
# los assets compilados (npm run build) deben viajar por git.
/public/hot

# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
.idea/
.vscode/

# =========================
# Logs
# =========================
*.log
